# Copy this file to .env and fill in your key. NEVER commit .env
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0
BATCH_MAX_CONCURRENCY=5
MAX_UPLOAD_ROWS=200
SAMPLE_CSV_PATH=data/sample_vendor_rows.csv

# Supabase: Project settings > API. Use the service-role (secret) key, server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# CX Support Copilot (Step 3). Leave empty to use LLM_MODEL for every step.
CX_CLASSIFIER_MODEL=
CX_DRAFT_MODEL=
CX_EVAL_MODEL=
