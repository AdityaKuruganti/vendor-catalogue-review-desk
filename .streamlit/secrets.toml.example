# Local: copy to .streamlit/secrets.toml (gitignored).
# Streamlit Community Cloud: paste into App > Settings > Secrets.
OPENROUTER_API_KEY = "sk-or-..."
SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_SERVICE_KEY = "sb_secret_..."   # the SECRET key, not sb_publishable
LLM_MODEL = "openai/gpt-4o-mini"
# LLM_BASE_URL = "https://openrouter.ai/api/v1"
# BATCH_MAX_CONCURRENCY = "5"
# MAX_UPLOAD_ROWS = "200"
# CX Support Copilot (optional; defaults to LLM_MODEL)
# CX_CLASSIFIER_MODEL = "openai/gpt-4o-mini"
# CX_DRAFT_MODEL = "openai/gpt-4o"
# CX_EVAL_MODEL = "openai/gpt-4o-mini"
